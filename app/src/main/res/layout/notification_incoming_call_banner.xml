<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/banner_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_incoming_call_banner"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="18dp"
    android:paddingEnd="18dp"
    android:paddingBottom="18dp">

    <TextView
        android:id="@+id/tv_caller_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:paddingEnd="14dp"
        android:text="Incoming Call"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btn_decline_call"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_circle_decline_red"
        android:contentDescription="Decline call"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_end_white" />

    <ImageButton
        android:id="@+id/btn_answer_call"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="14dp"
        android:background="@drawable/bg_circle_answer_green"
        android:contentDescription="Answer call"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_call_answer_white" />

</LinearLayout>
